spec: v0.6

# 关键：必须声明 runtime，否则构建出来的是 kernel-less 镜像，
# 启动时会报 "No platform kernel available for kernel-less image: ENOMEDIUM"
runtime: base-compat:latest

rootfs: ./Dockerfile

# Uptime Kuma 用相对路径找 dist/index.html，必须把工作目录切到 /app，
# 否则会报 "Cannot find 'dist/index.html'" 并退出
cmd: ["/bin/sh", "-c", "cd /app && exec /usr/local/bin/node server/server.js"]
